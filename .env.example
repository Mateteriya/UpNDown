# Supabase — авторизация и онлайн-игра
# Скопируйте в .env.local и подставьте значения из https://supabase.com/dashboard
# Вечеринка + OAuth + рейтинг (без VPN / без сайта):
#   Redirect URLs (игра): см. docs/ЛОКАЛЬНАЯ-РАЗРАБОТКА.md и панель хоста
#   Яндекс/VK Redirect URI = https://ВАШ_ПРОЕКТ.supabase.co/auth/v1/callback
#     (не URL игры!) — docs/AUTH-YANDEX-VK-MAIL.md
#   Site URL на вечер: http://ВАШ_IP:3001/play/  (без ?code= и #)
#   После вечеринки Site URL снова: https://up2down.online
# Dev Vite: http://localhost:5173/auth-callback.html
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Домашний WS (`npm run host:app`): запись матча/ELO в тот же Supabase.
# Только в .env.local, без префикса VITE_ (иначе ключ уйдёт в браузер).
# Dashboard → Project Settings → API → service_role (secret).
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# URL можно не дублировать: сервер возьмёт VITE_SUPABASE_URL.

# После миграции game_state_revision: true — оптимистичные записи с проверкой ревизии (меньше гонок).
# Без миграции оставьте закомментированным или false.
# VITE_ONLINE_REVISION_LOCK=true

# Опционально: URL для приглашений при тесте с телефона без деплоя.
# Запустите dev с --host, узнайте IP ПК в сети (ipconfig / ifconfig), укажите сюда, например:
# VITE_INVITE_URL=http://192.168.1.5:5173
# VITE_INVITE_URL=

# Монетизация / roadmap flags (см. docs/PARTNERSHIP-WAVE5-TRIGGERS.md)
# VITE_CASH_ARENA_ENABLED=false
# VITE_GEO_RU_CC_ONLY=true
# VITE_CC_LEDGER_ENABLED=false
# Зал столов: по умолчанию включён; выключить: VITE_PUBLIC_HALL_ENABLED=false
# VITE_CC_TOURNAMENTS_ENABLED=false

# Музыкальная студия (шаринг в проде): /#studio=ether или ?studio=ether
# VITE_MUSIC_STUDIO_KEY=ether
# Полный список лаб на хосте (по умолчанию — localhost/staging/DEV): VITE_DEV_ATELIER=true

# Локальный игровой сервер (Wi‑Fi, без Supabase в партии):
# 1) npm run server:dev
# 2) ipconfig → IP ПК, например 192.168.1.5
# VITE_ONLINE_TRANSPORT=ws
# VITE_WS_URL=ws://192.168.1.5:3001

# Облачный WS (когда техдир сдал game.up2down.online) — см. docs/OWNER-WS-CHECKLIST-NOW.md
# и deploy/env.ws.preview.example. Сначала Preview/локаль, не Production.
# VITE_ONLINE_TRANSPORT=ws
# VITE_WS_URL=wss://game.up2down.online

# Premium (web entitlement, без стора) — см. #premium / src/lib/premiumEntitlement.ts
# VITE_PREMIUM_HISTORY=true
# VITE_PREMIUM_USER_IDS=your-supabase-user-uuid
# VITE_PREMIUM_DEV_TOGGLE=1

# Донаты (страница #support / «Поддержать» в меню и ЛК).
# CloudTips и ЮMoney. Пустые — карточки с «ссылка скоро».
# VITE_DONATE_CLOUDTIPS=https://pay.cloudtips.ru/…
# VITE_DONATE_YOOMONEY=https://yoomoney.ru/…

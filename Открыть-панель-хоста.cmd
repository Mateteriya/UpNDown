@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo.
echo  Up^&Down — панель хозяина (одна на ПК).
echo  Если панель уже запущена — откроется та же, без второго сервера.
echo.
echo  Панель:   http://127.0.0.1:3927/
echo  Игра/QR:  http://ВАШ_IP:3001/play/   ^(семья и Зал столов — сюда^)
echo  НЕ :5173  ^(это только разработка в Cursor^)
echo.
echo  Один раз после обновления кода: в панели кнопка «Пересобрать» игру
echo  ^(или: npm run party:rebuild^) — чтобы карты попали в кэш телефонов.
echo.
echo  На время партии закройте Cursor — меньше зависаний.
echo  Это окно можно свернуть; закройте только когда вечеринка закончена.
echo.
call npm run host:control
echo.
if errorlevel 1 (
  echo  Ошибка запуска. Если порт занят старым процессом — закройте лишние окна node/cmd и повторите.
) else (
  echo  Готово. Либо панель работает в этом окне, либо уже была открыта — браузер на ту же.
)
echo.
pause

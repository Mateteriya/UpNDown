{
  "name": "updown-game-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude ./data/** --exclude ./dist/** src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js"
  },
  "dependencies": {
    "jose": "^6.2.9",
    "nat-upnp": "^1.1.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "up-down": "file:..",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.12"
  }
}

# /etc/updown/ws.env — chmod 600, владелец root:updown
# Не коммитить с секретами. Скопировать: sudo cp deploy/updown-ws.env.example /etc/updown/ws.env

# Legacy JWT Secret (HS256) — Supabase → Project Settings → API → JWT Secret
# Не anon key и не JWKS.
SUPABASE_JWT_SECRET=

# Нужны для записи матча/Elo с WS (finish_game_from_server)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

PUBLIC_WS_URL=wss://game.example.com

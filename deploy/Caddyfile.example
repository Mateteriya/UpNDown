# Пример Caddy для игрового WS (TLS + reverse_proxy).
# Канон продукта: game.up2down.online → см. docs/TECH-DIRECTOR-WS-1PAGE.md
# Перезагрузка: sudo systemctl reload caddy
#
# Проверка:
#   curl -s https://game.up2down.online/api/health
#   curl -s https://game.up2down.online/api/ready
# Клиент: VITE_WS_URL=wss://game.up2down.online

game.up2down.online {
	encode gzip
	reverse_proxy 127.0.0.1:3001
}
